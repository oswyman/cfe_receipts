# Copia este archivo como .env y llena los valores

# Clave secreta de Django (genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta

# API de Anthropic (Claude) — obtén tu clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Entorno (True en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos en producción (separados por coma, ej: midominio.com,www.midominio.com)
# ALLOWED_HOSTS=
